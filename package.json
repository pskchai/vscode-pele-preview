    "configuration": {
      "title": "Pele Preview",
      "properties": {
        "pelePreview.maxZoom": {
          "type": "number",
          "default": 5,
          "description": "Maximum zoom as a multiple of 100%. A value of 5 means 500%."
        },
        "pelePreview.maxTextSize": {
          "type": "number",
          "default": 90000,
          "description": "Maximum number of characters in diagram source."
        },
        "pelePreview.maxEdges": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of edges in a diagram."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "pelePreview.preview",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid)$/ || resourceLangId =~ /^mermaid/",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "pelePreview.preview",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid)$/ || resourceLangId =~ /^mermaid/",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "pelePreview.preview",
        "title": "Preview Diagram",
        "category": "Pele Preview",
        "icon": "images/mermaid-icon.svg"
      },
      {
        "command": "pelePreview.createDiagram",
        "title": "Create Diagram",
        "category": "Pele Preview"
      },
      {
        "command": "pelePreview.diagramHelp",
        "title": "Diagram Help",
        "category": "Pele Preview"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "precompile": "pnpm --filter ./webview build && webpack --mode=production --config ./build/markdownPreview.webpack.config.js",
    "build:icons": "node scripts/build-icons.mjs",
    "compile": "tsc -p ./ --noEmit && esbuild ./src/extension.ts --sourcemap --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "prewatch": "pnpm build:icons",
    "watch": "tsc -p ./ --noEmit --watch",
    "pretest": "pnpm compile && pnpm compile:tests && pnpm lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:renderers": "pnpm compile && node scripts/test-renderers.cjs",
    "package": "pnpm vsce package --no-dependencies",
    "publish": "pnpm vsce publish --no-dependencies",
    "compile:tests": "esbuild src/test/runTest.ts src/test/suite/index.ts src/test/suite/extension.test.ts --outbase=src/test --outdir=out/test --platform=node --format=cjs --external:vscode --packages=external --bundle"
  },
